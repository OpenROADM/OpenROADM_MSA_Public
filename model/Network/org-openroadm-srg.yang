  revision 2026-05-29 {
    description
      "Version 19.1.0";
  }
  revision 2026-03-27 {
    description
      "Version 19.0.0";
  }
  revision 2025-12-12 {
    description
      "Version 18.1.0";
  }
  revision 2025-09-26 {
    description
      "Version 18.0.0";
  }
  revision 2025-05-30 {
    description
      "Version 17.1.0";
  }
  revision 2025-03-28 {
    description
      "Version 17.0";
  }
  revision 2024-12-13 {
    description
      "Version 16.1";
  }
  revision 2024-09-27 {
    description
      "Version 16.0";
  }
  revision 2023-05-26 {
    description
      "Version 13.1";
  }
  revision 2021-12-10 {
    description
      "Version 10.1";
  }
  revision 2021-09-24 {
    description
      "Version 10.0";
  }
  revision 2021-03-26 {
    description
      "Version 9.0";
  }
  revision 2020-05-29 {
    description
      "Version 7.1.0";
  }
  revision 2020-03-27 {
    description
      "Version 7.0.0";
  }
  revision 2019-11-29 {
    description
      "Version 6.1.0";
  }
  revision 2019-09-27 {
    description
      "Version 6.0.0";
  }
  revision 2019-03-29 {
    description
      "Version 5.0.0";
  }
  revision 2018-11-30 {
    description
      "Version 4.1.0";
  }
  revision 2018-09-28 {
    description
      "Version 4.0.0";
  }
  revision 2018-05-30 {
    description
      "Version 3.1.0";
  }
  revision 2018-03-30 {
    description
      "Version 3.0.0";
  }
  revision 2017-12-15 {
    description
      "Version 2.2";
  }
  revision 2017-09-29 {
    description
      "Version 2.1";
  }
  revision 2017-07-28 {
    description
      "Version 2.0.1 - added revision-date to imports";
  }
  revision 2017-06-26 {
    description
      "Version 2.0";
  }
  revision 2016-10-14 {
    description
      "Version 1.2";
  }

  grouping srg-node-attributes {
    leaf srg-number {
      type uint16;
    }
    leaf max-pp {
      type uint32;
      description
        "Maximum number of add/drop port pairs in an SRG";
    }
    leaf current-provisioned-pp {
      type uint32;
      description
        "current provisioned number of port pair in a given SRG";
    }
    leaf wavelength-duplication {
      type org-openroadm-common-optical-channel-types:wavelength-duplication-type;
    }
    leaf-list supported-operational-modes {
      type string;
      config true;
      description
        "defines the supported openroadm specifications";
    }
    uses srg-constraints;
  }

  grouping srg-constraints {
    uses constraints-grp;
    uses capabilities;
    uses mc-profiles;
    list subgroup {
      key "subgroup-id";
      description
        "The list of SRG subgroups that make up the SRG";
      leaf subgroup-id {
        type uint16;
        description
          "The identifier for the SRG subgroup within the SRG";
      }
      leaf lifecycle-state {
        type org-openroadm-common-state-types:lifecycle-state;
        description
          "Lifecycle State of subgroup. Whether it is planned, deployed, in maintenance, etc.";
      }
      leaf operational-state {
        type org-openroadm-common-state-types:state;
      }
      leaf administrative-state {
        type org-openroadm-equipment-states-types:admin-states;
      }
      uses constraints-grp;
      uses capabilities;
      uses mc-profiles;
      leaf-list tp-list {
        type leafref {
          path "/nd:networks/nd:network/nd:node[nd:node-id=current()/../../../nd:node-id]/nwt:termination-point/nwt:tp-id";
        }
        description
          "The list of termination-point refs associated with the SRG subgroup";
      }
    }
  }

  grouping constraints-grp {
    container constraints {
      leaf min-slot-width {
        type org-openroadm-common-optical-channel-types:frequency-GHz;
        description
          "The minimum media channel(MC) slot width that can be added or dropped from the SRG/sub-SRG.";
      }
      leaf max-slot-width {
        type org-openroadm-common-optical-channel-types:frequency-GHz;
        description
          "The maximum media channel(MC) slot width in GHz that can be added or dropped from the SRG/sub-SRG.";
      }
      leaf min-input-psd {
        type org-openroadm-common-link-types:psd-dBm-50GHz;
        description
          "The minimum allowable input power spectral density (PSD) for a channel added to the SRG/sub-SRG. The type of channel (MC or NMC) depends on psd-reference.";
      }
      leaf max-input-psd {
        type org-openroadm-common-link-types:psd-dBm-50GHz;
        description
          "The maximum allowable input power spectral density (PSD) for a channel added to the SRG/sub-SRG. The type of channel (MC or NMC) depends on psd-reference.";
      }
      leaf target-input-psd {
        type org-openroadm-common-link-types:psd-dBm-50GHz;
        description
          "The desired input power spectral density (PSD) for a channel added to the SRG/sub-SRG. The type of channel (MC or NMC) depends on psd-reference.";
      }
      leaf psd-reference {
        type org-openroadm-common-types:psd-reference;
        default "mc-width";
        description
          "The desired channel type (media channel or network media channel) over which to apply power spectral density calculation. Acceptable values are: mc-width or nmc-width.
           The value of psd-reference should be set to Media Channel for OpenROADM standard devices. It can be set to either value for OLS style deployments.";
      }
      leaf port-count-limit {
        type uint32;
        description
          "The total number of ports that can be used SRG/sub-SRG. This is determined by the allowable number of the max-slot-width channels and assumes a single channel per port.
           It may vary from the total number of available ports depending the value of max-slot-width.";
      }
      leaf max-composite-input-power {
        type org-openroadm-common-link-types:power-dBm;
        description
          "The maximum total power of all channels (summed together) added to the SRG/sub-SRG that is allowable. This limit is intended to prevent saturating amplifiers within the SRG/sub-SRG.
           It is used to define the limits of the Add side of the device. The channel type (MC or NMC) depends on the value of psd-reference.";
      }
      leaf max-total-bandwidth {
        type org-openroadm-common-optical-channel-types:frequency-GHz;
        description
          "The allowable total bandwidth of all channels (summed together) through the SRG/sub-SRG. This can be used for general limits other than those from the Add side amplifier saturation.
           These are generally caused by the Drop side amplifier limitations. The channel type (MC or NMC) depends on the value of psd-reference.";
      }
      leaf available-composite-input-power {
        type org-openroadm-common-link-types:power-dBm;
        description
          "The remaining composite power that can be added for the SRG/sub-SRG. This value is computed as the max-composite-input-power – sum of the provisioned input powers of
           all channels currently on the SRG/sub-SRG. The channel type (MC or NMC) depends on the value of psd-reference.";
      }
      leaf available-total-bandwidth {
        type org-openroadm-common-optical-channel-types:frequency-GHz;
        description
          "The remaining total bandwidth that can be added for the SRG/sub-SRG. This value is computed as the max-total-bandwidth – sum of the bandwidths of
           all channels currently on the SRG/sub-SRG. The channel type (MC or NMC) depends on the value of psd-reference.";
      }
    }
  }

  grouping capabilities {
    container capability {
      leaf min-input-psd {
        type org-openroadm-common-link-types:psd-dBm-50GHz;
        description
          "The minimum allowable input power spectral density (PSD) for a channel added to the SRG/sub-SRG. The type of channel (MC or NMC) depends on psd-reference.";
      }
      leaf max-input-psd {
        type org-openroadm-common-link-types:psd-dBm-50GHz;
        description
          "The maximum allowable input power spectral density (PSD) for a channel added to the SRG/sub-SRG. The type of channel (MC or NMC) depends on psd-reference.";
      }
      leaf psd-reference {
        type org-openroadm-common-types:psd-reference;
        default "mc-width";
        description
          "The desired channel type (media channel or network media channel) over which to apply power spectral density calculation. Acceptable values are: mc-width or nmc-width.
           The value of psd-reference should be set to Media Channel for OpenROADM standard devices. It can be set to either value for OLS style deployments.";
      }
      leaf max-composite-input-power {
        type org-openroadm-common-link-types:power-dBm;
        description
          "The maximum total power of all channels (summed together) added to the SRG/sub-SRG that is allowable. This limit is intended to prevent saturating amplifiers within the SRG/sub-SRG.
           It is used to define the limits of the Add side of the device. The channel type (MC or NMC) depends on the value of psd-reference.";
      }
      leaf max-total-bandwidth {
        type org-openroadm-common-optical-channel-types:frequency-GHz;
        description
          "The allowable total bandwidth of all channels (summed together) through the SRG/sub-SRG. This can be used for general limits other than those from the Add side amplifier saturation.
           These are generally caused by the Drop side amplifier limitations. The channel type (MC or NMC) depends on the value of psd-reference.";
      }
    }
  }

  grouping mc-profiles {
    list mc-profile {
      key "profile-name";
      leaf profile-name {
        type string;
        mandatory true;
      }
      leaf center-freq-granularity {
        type org-openroadm-common-optical-channel-types:frequency-GHz;
        default "50";
        config false;
        description
          "Granularity of allowed center frequencies. The base frequency for this computation is 193.1 THz (G.694.1)";
      }
      leaf min-edge-freq {
        type org-openroadm-common-optical-channel-types:frequency-THz;
        config false;
        description
          "Minimum edge frequency";
      }
      leaf max-edge-freq {
        type org-openroadm-common-optical-channel-types:frequency-THz;
        config false;
        description
          "Maximum edge frequency";
      }
      leaf slot-width-granularity {
        type org-openroadm-common-optical-channel-types:frequency-GHz;
        default "50";
        config false;
        description
          "Width of a slot measured in GHz";
      }
      leaf min-slot-width {
        type org-openroadm-common-optical-channel-types:frequency-GHz;
        description
          "The minimum slot width in frequency-GHz";
      }
      leaf max-slot-width {
        type org-openroadm-common-optical-channel-types:frequency-GHz;
        description
          "The maximum slot width in frequency-GHz";
      }
    }
  }
}
